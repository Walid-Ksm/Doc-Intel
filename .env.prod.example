# ==============================================================================
# Document Intelligence Platform — Production Environment Variables
# Copy to .env.prod or use with docker-compose.prod.yml
# ==============================================================================

# PostgreSQL Database (Container: postgres:5432)
POSTGRES_USER=walid
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=doc_intelligence
DATABASE_URL=postgresql+psycopg2://walid:devpassword@postgres:5432/doc_intelligence

# MinIO Object Storage (Container: minio:9000)
MINIO_ROOT_USER=walid
MINIO_ROOT_PASSWORD=devpassword123
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=walid
MINIO_SECRET_KEY=devpassword123
MINIO_BUCKET_NAME=documents

# Redis Task Broker & Cache (Container: redis:6379)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Keycloak IAM (Container: keycloak:8080)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=doc-intelligence
KEYCLOAK_CLIENT_ID=doc-intelligence-ui
AUTH_ENABLED=true
DEV_USER_ADAM_PASSWORD=devpassword

# Ollama LLM Engine (Routed to Host Machine by Default)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:1b

# CORS & Gateway Settings
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:9080,http://localhost
CORS_ORIGINS=http://localhost:4200,http://localhost:9080,http://localhost

# APISIX Ingress Admin
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# Optional LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=doc-intelligence-rag
