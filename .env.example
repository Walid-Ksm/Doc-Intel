
# Configuration de la base de données PostgreSQL

DATABASE_URL=postgresql+psycopg2://walid:devpassword@localhost:15432/doc_intelligence


# Configuration du stockage objet (MinIO / S3)

MINIO_ENDPOINT=http://localhost:9000

# Les identifiants de connexion (Access Key et Secret Key)
MINIO_ACCESS_KEY=walid
MINIO_SECRET_KEY=devpassword123

# Le nom du bucket dans lequel les documents seront stockés. 
# Ce bucket doit exister dans MinIO, ou être créé automatiquement par l'app.
MINIO_BUCKET_NAME=documents

# Liste des origines autorisées par le middleware CORS (séparées par des virgules).
# En développement local, laisser la valeur par défaut (Angular dev server).
# En production, remplacer par l'URL réelle du frontend.
ALLOWED_ORIGINS=http://localhost:4200

# Configuration du service LLM local (Ollama)
# URL de base de l'instance Ollama locale
OLLAMA_BASE_URL=http://localhost:11434

# Modèle Ollama utilisé pour la génération de réponses RAG
OLLAMA_MODEL=gemma3:1b

# Configuration de la file de tâches Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Configuration de l'authentification Keycloak (OIDC / JWT)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=doc-intelligence
KEYCLOAK_CLIENT_ID=doc-intelligence-ui
AUTH_ENABLED=true
DEV_USER_ADAM_PASSWORD=your_dev_user_adam_password_here

# Configuration de la visualisation web LangSmith (LangGraph Tracing & Visualizer)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=doc-intelligence-rag



